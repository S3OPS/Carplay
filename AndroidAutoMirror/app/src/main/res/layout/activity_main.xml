<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android Auto Mirror"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="30dp"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textSize="18sp"
        android:layout_marginBottom="40dp"
        android:textColor="?android:attr/textColorSecondary" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Mirroring"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Stop Mirroring"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#F44336"
        android:enabled="false" />

    <TextView
        android:id="@+id/instructionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instructions:\n\n1. Connect your phone to Android Auto\n2. Tap 'Start Mirroring' to begin\n3. Your phone screen will be captured\n4. Open any app (Photos, YouTube, etc.)\n5. Content will be mirrored\n6. Tap 'Stop Mirroring' when done\n\n⚠️ SAFETY: Never watch video while driving. Passenger use only!"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
